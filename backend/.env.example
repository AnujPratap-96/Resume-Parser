GROQ_API_KEY=gsk_your_key_here
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT=20
LLM_MAX_RETRIES=2

# Comma-separated origins allowed to call the API.
# Defaults to localhost:5173 (Vite dev) when unset — set your deployed
# frontend URL in production. Use "*" only if you accept an open API.
ALLOWED_ORIGINS=http://localhost:5173

# Set to false when the app is exposed directly (no proxy in front).
# When true, the client IP is read from X-Forwarded-For for rate limiting.
TRUST_PROXY=true

# Limits
RATE_LIMIT_MAX=10       # analyses per minute per client (LLM calls)
RATE_LIMIT_BURST=60     # total requests per minute per client
MAX_FILE_MB=5
MAX_JD_CHARS=10000
ANALYSIS_TIMEOUT=120    # seconds for one full analysis
